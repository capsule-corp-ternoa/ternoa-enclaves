	"item": [
		{
			"name": "ENCLAVE HEALTH",
			"item": [
				{
					"name": "Health Check",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Response status code is 206\", function () {",
									"    pm.expect(pm.response.to.have.status(206));",
									"});",
									"",
									"",
									"pm.test(\"Response time is less than 200ms\", function () {",
									"  pm.expect(pm.response.responseTime).to.be.below(200);",
									"});",
									"",
									"",
									"pm.test(\"Response has the required fields\", function () {",
									"  const responseData = pm.response.json();",
									"  ",
									"  pm.expect(responseData).to.be.an('object');",
									"  pm.expect(responseData.chain).to.exist;",
									"  pm.expect(responseData.block_number).to.exist;",
									"  pm.expect(responseData.sync_state).to.exist;",
									"  pm.expect(responseData.secrets_number).to.exist;",
									"  pm.expect(responseData.version).to.exist;",
									"  pm.expect(responseData.description).to.exist;",
									"  pm.expect(responseData.enclave_address).to.exist;",
									"});",
									"",
									"",
									"pm.test(\"Chain, sync state, version, and enclave address are non-empty strings\", function () {",
									"    const responseData = pm.response.json();",
									"    ",
									"    pm.expect(responseData).to.be.an('object');",
									"    ",
									"    const propertiesToCheck = [\"chain\", \"sync_state\", \"version\", \"enclave_address\"];",
									"    propertiesToCheck.forEach(property => {",
									"        pm.expect(responseData[property]).to.be.a('string').and.to.have.lengthOf.at.least(1, `${property} should not be empty`);",
									"    });",
									"});",
									"",
									"",
									"pm.test(\"Block number and secrets number are non-negative integers\", function () {",
									"    const responseData = pm.response.json();",
									"    ",
									"    pm.expect(responseData.block_number).to.be.a('number').and.to.satisfy((num) => num >= 0, \"Block number should be a non-negative integer\");",
									"    pm.expect(responseData.secrets_number).to.be.a('number').and.to.satisfy((num) => num >= 0, \"Secrets number should be a non-negative integer\");",
									"});",
									""
								],
								"type": "text/javascript",
								"packages": {}
							}
						}
					],
